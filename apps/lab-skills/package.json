{
  "name": "lab-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lab-skills": "bin/lab-skills.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.test.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:bun": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "tui": "node bin/lab-skills.mjs plan --tui",
    "tui:demo": "node bin/scratchpad.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5",
    "effect-boxes": "0.18.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tar-stream": "3.1.7",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@repo/config-typescript": "workspace:*",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.0",
    "@types/tar-stream": "3.1.4"
  }
}
